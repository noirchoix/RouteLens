REACTS_PROJECT_ROOT=.
REACTS_SOURCE_ARTIFACT=data/source_artifacts/uspto_llm_multistep_only.zip
REACTS_CANONICAL_DIR=data/canonical
REACTS_CANONICAL_V2_CONTEXT_DIR=data/canonical_v2_context
REACTS_MAPPING_V2_DIR=data/mapping_v2
REACTS_DERIVATION_V2_DIR=data/derivation_v2
REACTS_CANONICAL_V2_DIR=data/canonical_v2
REACTS_MAPPING_QUEUE_DB=data/state/product_two_mapping.sqlite3
REACTS_DERIVATION_QUEUE_DB=data/state/product_two_derivation.sqlite3
REACTS_MODEL_DIR=data/models
REACTS_INDEX_DIR=data/indexes
REACTS_INDEX_V2_DIR=data/indexes_v2
REACTS_BASELINE_DIR=data/baselines/v1.0.0-baseline
REACTS_REGISTRY_DB=data/registry/reacts.sqlite3
REACTS_REPORTS_DIR=reports
REACTS_RELEASES_DIR=data/releases
REACTS_REQUIRE_API_KEY=false
REACTS_API_KEY=
REACTS_MAX_BATCH_ROWS=100000
REACTS_TEMPERATURE_MIN_C=-150
REACTS_TEMPERATURE_MAX_C=350
REACTS_TIME_MIN_H=0.0002777778
REACTS_TIME_MAX_H=8760
REACTS_MAPPING_BACKEND=auto
REACTS_MAPPING_MIN_COVERAGE=0.60
REACTS_MAPPING_TIMEOUT_SECONDS=3
REACTS_MAPPING_BATCH_SIZE=16
REACTS_MAPPING_SHARD_SIZE=5000
REACTS_MAPPING_PREFETCH_BATCHES=2
REACTS_MAPPING_STALE_AFTER_MINUTES=60
REACTS_EVIDENCE_IN_DOMAIN_THRESHOLD=0.65
REACTS_EVIDENCE_WEAK_THRESHOLD=0.35
REACTS_INFERENCE_ABSTENTION_THRESHOLD=0.35

# Product Two v2.1.0 immutable artifact-backed inference runtime
REACTS_ARTIFACT_URI=
REACTS_ARTIFACT_RELEASE=product-two-artifacts-v2.0.12
REACTS_ARTIFACT_CACHE_DIR=data/artifact_cache
REACTS_ARTIFACT_VERIFY_SHA256=true
REACTS_ARTIFACT_REQUIRED=false
REACTS_ARTIFACT_WARMUP=true
REACTS_ARTIFACT_LOCK_TIMEOUT_SECONDS=120
REACTS_OFFLINE_MODE=false

# Inference service hardening
REACTS_INFERENCE_MAX_BATCH_ROWS=256
REACTS_MAX_REQUEST_BYTES=1048576
REACTS_REQUEST_TIMEOUT_SECONDS=30
REACTS_MAX_CONCURRENT_REQUESTS=8
REACTS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
REACTS_CORS_ORIGINS=
REACTS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
REACTS_ALLOW_EXPERIMENTAL_MODELS=false
