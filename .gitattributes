# Store source and documentation consistently as LF
* text=auto eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.parquet binary
*.joblib binary
*.npz binary
*.sqlite3 binary
*.db binary
